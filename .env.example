# Copy to .env.local for local development (never commit .env.local).
# On Vercel, set these in Project → Settings → Environment Variables, choosing
# the environments (Production / Preview / Development) for each one.
# None of these use the NEXT_PUBLIC_ prefix: they are server-only.
#
# Which environment gets what (see README → Deploying to Vercel):
#
#   Variable                 Production              Preview                  Local (.env.local)
#   OSU_CLIENT_ID/SECRET     required                required                 required
#   EDIT_TOKEN_SECRET        required (own value)    required (other value)   optional (dev secret)
#   PUBLIC_BASE_URL          recommended (domain)    leave UNSET              leave empty
#   DATABASE_URL             Neon `production`       Neon `development`       Neon `development`
#   BLOB_STORE_ID or token   production Blob store   dev Blob store           dev Blob store (optional)
#   BLOB_ACCESS              private                 private                  private
#
# On Vercel Production and Preview the app refuses to run publishing without
# DATABASE_URL, a Blob store (BLOB_STORE_ID or BLOB_READ_WRITE_TOKEN) and
# EDIT_TOKEN_SECRET: it never falls back to the in-memory database, local disk
# storage or the development secret. VERCEL=1 with VERCEL_ENV=development (as
# written by `vercel env pull` or `vercel dev`) counts as local, not hosted.

# ── osu! API (required everywhere for live player search and publishing) ─────
# osu.ppy.sh → Settings → OAuth → New OAuth Application (callback URL is unused).
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# ── Edit-link security (REQUIRED on Vercel) ──────────────────────────────────
# Random secret, at least 32 characters. Used to hash edit tokens and derive
# idempotent edit links. Generate with:  openssl rand -base64 48
# Use different values for Production and Preview. Set it before the first card
# is published: changing it invalidates every existing edit link (public cards
# keep working). Locally, a development-only secret is used if this is empty.
EDIT_TOKEN_SECRET=

# ── Public URL (recommended in Production) ───────────────────────────────────
# Origin used in BBCode, image URLs and QR codes, e.g. https://sig.example.com
# Pick your final domain before people start embedding cards.
# On Vercel, set it for Production only. If unset there, Production uses the
# project's production domain (VERCEL_PROJECT_PRODUCTION_URL) and Preview uses
# its own deployment URL (VERCEL_URL). Locally, the request origin is used.
PUBLIC_BASE_URL=

# ── Neon PostgreSQL (REQUIRED on Vercel) ─────────────────────────────────────
# Pooled connection string (the app uses Neon's HTTP driver). Production must use
# the Neon `production` branch; Preview and local use `development`.
#   neon connection-string production --pooled     (paste into Vercel yourself)
#   neon checkout development                       (writes it to .env.local)
# Then run migrations against that branch:  npm run db:migrate
# Locally, if empty, an in-memory database is used (cleared on dev-server restart).
DATABASE_URL=
# Written by the Neon CLI (neon checkout / neon deploy). Not read by the app;
# harmless to keep locally, no need to add them to Vercel.
# DATABASE_URL_UNPOOLED=
# NEON_BRANCH=
# NEON_BRANCH_ID=
# NEON_FUNCTION_HOST_SUFFIX=

# ── Vercel Blob (REQUIRED on Vercel) ─────────────────────────────────────────
# Create PRIVATE stores (Vercel → Storage → Blob): one for production, one for
# development/preview. Never point local development at the production store:
# `npm run images:gc` compares the store with the database it is connected to.
# Connecting a store to the Vercel project adds these variables automatically
# for the environments you select. Either of the first two enables Blob storage:
#   BLOB_STORE_ID           the store, for OIDC auth (recommended). The SDK pairs
#                           it with an OIDC token: on Vercel from each request; locally
#                           from a linked, logged-in Vercel CLI (`vercel link`).
#                           With OIDC the store itself only accepts the environments
#                           it allows, so Preview/local can never reach production.
#   BLOB_READ_WRITE_TOKEN   legacy read-write token for one store. Still supported;
#                           the SDK uses it only when no OIDC token is available.
#   BLOB_WEBHOOK_PUBLIC_KEY for Blob webhooks; not used by this app
# Check what is in use (never prints values):  npm run services:check
#   -- --oidc-only   prove OIDC works without the read-write token
#   -- --read-only   list only, no writes (for stores you must not write to)
# Locally, if both are empty, images are stored on disk outside the project folder.
# BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# "private" (default) if the store was created as private, "public" otherwise.
# Images are always served through /c/{id}.png, so private is recommended.
BLOB_ACCESS=private

# ── Provided by Vercel automatically (do not set) ────────────────────────────
# VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL, VERCEL_OIDC_TOKEN
# (keep "Automatically expose System Environment Variables" enabled)

# ── Optional ─────────────────────────────────────────────────────────────────
# How old a published card's stats must be before an image request triggers a
# background refresh. Default 12.
# STATS_REFRESH_HOURS=12
# Where local development data (images) is stored. Default: ~/.sigcard-studio/<project-hash>
# LOCAL_DATA_DIR=
# Testing only, NEVER on Vercel: point the osu! client at scripts/mock-osu.mjs.
# OSU_BASE_URL=
