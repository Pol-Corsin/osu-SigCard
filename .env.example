# Copy to .env.local for local development (never commit .env.local).
# In production, set these in Vercel → Project → Settings → Environment Variables.
# None of these use the NEXT_PUBLIC_ prefix: they are server-only.

# ── osu! API (required everywhere for live player search and publishing) ─────
# osu.ppy.sh → Settings → OAuth → New OAuth Application (callback URL is unused).
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# ── Edit-link security (REQUIRED in production) ──────────────────────────────
# Random secret, at least 32 characters. Used to hash edit tokens and derive
# idempotent edit links. Generate with:  openssl rand -base64 48
# Changing it invalidates every existing edit link (public cards keep working).
# Locally, a development-only secret is used if this is empty.
EDIT_TOKEN_SECRET=

# ── Public URL (REQUIRED in production) ──────────────────────────────────────
# Origin used in BBCode, image URLs and QR codes, e.g. https://sig.example.com
# Pick your final domain before people start embedding cards.
# Locally, the request origin (http://localhost:3000) is used if empty.
# On Vercel, scope it to Production only: previews then use their own deployment
# URL, and production falls back to the project's production domain if unset.
PUBLIC_BASE_URL=

# ── Neon PostgreSQL (REQUIRED in production) ─────────────────────────────────
# Neon console → your project → Connection string (pooled or direct both work;
# the app uses Neon's HTTP driver). Then run:  npm run db:migrate
# Locally, if empty, an in-memory database is used (cleared on dev-server restart).
DATABASE_URL=

# ── Vercel Blob (REQUIRED in production) ─────────────────────────────────────
# Vercel → Storage → Create Blob store → connect to the project. Vercel adds
# BLOB_READ_WRITE_TOKEN automatically; copy it here for local testing.
# Locally, if empty, images are stored on disk outside the project folder.
BLOB_READ_WRITE_TOKEN=
# "private" (default) if the store was created as private, "public" otherwise.
# Images are always served through /c/{id}.png, so private is recommended.
BLOB_ACCESS=private

# ── Optional ─────────────────────────────────────────────────────────────────
# How old a published card's stats must be before an image request triggers a
# background refresh. Default 12.
# STATS_REFRESH_HOURS=12
# Where local development data (images) is stored. Default: ~/.sigcard-studio/<project-hash>
# LOCAL_DATA_DIR=
# Testing only: point the osu! client at the fake server in scripts/mock-osu.mjs.
# OSU_BASE_URL=
