{
  "name": "osu-sigcard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:assets": "tsx scripts/build-assets.ts",
    "samples:generate": "tsx scripts/generate-samples.ts",
    "render:samples": "tsx scripts/render-samples.tsx",
    "typecheck": "tsc --noEmit",
    "test:serializer": "tsx scripts/test-serializer.tsx",
    "test": "vitest run",
    "osu:check": "tsx --env-file-if-exists=.env.local scripts/check-osu.ts",
    "test:metrics": "tsx scripts/test-metrics.ts",
    "test:parity": "tsx scripts/parity-check.mts",
    "fonts:build": "python scripts/fonts/build_fonts.py",
    "check": "tsc --noEmit && eslint src scripts tests && vitest run && tsx scripts/test-serializer.tsx && tsx scripts/test-metrics.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "services:check": "tsx --env-file-if-exists=.env.local scripts/check-services.ts",
    "images:gc": "tsx --env-file-if-exists=.env.local scripts/gc-images.ts",
    "test:e2e": "tsx scripts/e2e-publish.mts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@neondatabase/serverless": "^1.2.1",
    "@resvg/resvg-js": "^2.6.2",
    "@vercel/blob": "^2.9.0",
    "country-flag-icons": "^1.6.20",
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@neon/config": "^1.14.8",
    "@neon/env": "^2.1.11",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/opentype.js": "^1.3.10",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsqr": "^1.4.0",
    "opentype.js": "^2.0.0",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.65.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
